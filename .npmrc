# Public npm, deliberately. Vercel reads this file, so it must not point at any
# private mirror or the deploy build will fail.
registry=https://registry.npmjs.org/

# If this registry is unreachable on your network (a TLS-inspecting proxy will
# sever the handshake rather than refuse the connection), install through your
# registry mirror and then normalise the lockfile:
#
#   npm install <pkg> --registry=<your mirror>
#   npm run relock
#
# Mirrors serve byte-identical tarballs and npm verifies `integrity` rather
# than the URL, so the rewrite is safe. See scripts/relock.mjs.
