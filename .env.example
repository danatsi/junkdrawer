# Supabase — service-role key, server-side only. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret the iOS Shortcut sends to POST /api/capture
CAPTURE_TOKEN=

# Frontend gate (see PLAN.md §5) — the password you type on /unlock, once per
# device. A passphrase rather than a hex string, because you type it by hand on
# a phone; five words from a 28k wordlist is ~74 bits. Generate one with:
#   grep -E '^[a-z]{4,6}$' /usr/share/dict/words | sort -u | python3 -c "import secrets,sys; w=[l.strip() for l in sys.stdin if l.strip()]; print('-'.join(secrets.choice(w) for _ in range(5)))"
# Changing it signs every device out, by design.
APP_UNLOCK_SECRET=

# Enrichment
GEMINI_API_KEY=
# Optional — defaults to gemini-3.1-flash-lite. Set this if the name moves on;
# check with: curl "https://generativelanguage.googleapis.com/v1/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=
TMDB_API_KEY=
OMDB_API_KEY=
