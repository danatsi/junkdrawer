# Supabase — service-role key, server-side only. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret the iOS Shortcut sends to POST /api/capture
CAPTURE_TOKEN=

# Frontend gate (see PLAN.md §5) — visit /unlock?k=<this> once per device
APP_UNLOCK_SECRET=

# Enrichment
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash. Set this if the model name moves on;
# check with: curl "https://generativelanguage.googleapis.com/v1/models?key=$GEMINI_API_KEY"
GEMINI_MODEL=
TMDB_API_KEY=
OMDB_API_KEY=
